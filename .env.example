# Copy to .env and fill in. .env is gitignored.
OPENAI_API_KEY=sk-...

# Optional overrides
# SIZESET_TRANSCRIBE_MODEL=gpt-transcribe
# SIZESET_DATA_DIR=./data
# Live transcription while recording. Empty turns the monitor off.
# SIZESET_REALTIME_MODEL=gpt-live-transcribe

# Where the job registry lives. Unset means jobs are kept in memory and lost
# on restart, which is the old behaviour and still runs the whole pipeline.
# Set means inspections survive a restart — and then `alembic upgrade head`
# has to have been run against it.
#
#   local:      DATABASE_URL=sqlite:///data/sizeset.db
#   deployment: DATABASE_URL=postgresql+psycopg://user:pass@host:5432/sizeset
DATABASE_URL=


# ---------- object storage ----------
# Where recordings and finished reports live. Unset means disk only, which is
# the old behaviour: one server, and a replaced container loses the documents.
# Set means any machine can answer for any inspection.
#
# Railway prints these under the bucket's Variables tab; the BUCKET_* names it
# injects are read too, so a Railway deployment needs none of this by hand.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Most S3-compatible providers ignore it; sign with it anyway.
# S3_REGION=us-east-1
